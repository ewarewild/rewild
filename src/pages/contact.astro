---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Get in touch - Rewild" description="Get in touch with Rewild.">

  <!-- Navigation -->
  <Nav />

  <!-- Form section -->
  <section class="bg-cream min-h-screen pt-32 pb-40 md:pt-44 md:pb-56">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <a href="/" class="inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-forest/60 hover:text-forest transition-colors duration-200 mb-12">
        <span>←</span><span>Home</span>
      </a>
      <div class="max-w-xl">
        <h1 class="font-display font-light text-4xl md:text-5xl text-forest mb-14 leading-tight">Get in touch</h1>

        <form
          id="contact-form"
          class="space-y-6"
        >
          <input type="hidden" name="access_key" value="ee1b8b87-7dbe-406e-b5e5-3bb4cabe5ec4" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div>
            <label class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Name</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input
                type="text"
                id="firstName"
                name="First name"
                placeholder="First name"
                aria-label="First name"
                required
                class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
              />
              <input
                type="text"
                id="lastName"
                name="Last name"
                placeholder="Last name"
                aria-label="Last name"
                required
                class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Email address</label>
            <input
              type="email"
              id="email"
              name="Email"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div>
            <label for="subject" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div>
            <label for="message" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Message</label>
            <textarea
              id="message"
              name="Message"
              rows="5"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <div class="pt-4">
            <button
              id="contact-submit"
              type="submit"
              class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
            >
              Send
            </button>
            <p id="contact-status" class="text-sm font-light mt-4" role="status"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-forest text-white py-14 px-6">
    <div class="max-w-6xl mx-auto flex flex-col items-center gap-2 text-center">
      <p class="text-white/30 text-xs font-light">© 2025 Rewild</p>
    </div>
  </footer>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement;
  const statusEl = document.getElementById('contact-status') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    statusEl.textContent = '';

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        statusEl.textContent = "Thank you - your message has been sent. We'll be in touch soon.";
        statusEl.className = 'text-sm font-light mt-4 text-sage';
      } else {
        statusEl.textContent = 'Something went wrong sending your message. Please try again in a moment.';
        statusEl.className = 'text-sm font-light mt-4 text-red-700';
      }
    } catch {
      statusEl.textContent = 'Something went wrong sending your message. Please try again in a moment.';
      statusEl.className = 'text-sm font-light mt-4 text-red-700';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send';
    }
  });
</script>
