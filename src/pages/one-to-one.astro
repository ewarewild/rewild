---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="One-to-One - Rewild" description="Tailor made activities for your individual needs. A personally guided program for maximum support in fulfilling your goals and intentions.">

  <!-- Navigation -->
  <Nav />

  <!-- Hero image -->
  <section class="relative mt-[60px] overflow-hidden" style="height: 65vh;">
    <div
      class="absolute inset-0 bg-cover bg-no-repeat"
      style="background-image: url('/images/rondane2.webp'); background-position: center 60%;"
    ></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.5) 0%, transparent 60%);"></div>
    <a href="/#events" class="absolute top-6 left-6 md:left-12 inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-white/60 hover:text-white transition-colors duration-200">
      <span>←</span><span>All events</span>
    </a>
  </section>

  <!-- Title strip (bg-white) -->
  <div class="bg-white py-10 px-6 text-center">
    <p class="font-display font-light italic text-forest text-xl md:text-2xl lg:text-3xl leading-relaxed max-w-2xl mx-auto">Your path, your pace.</p>
  </div>

  <!-- Intro section (bg-cream) -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <a href="/" class="inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-forest/60 hover:text-forest transition-colors duration-200 mb-12">
        <span>←</span><span>Home</span>
      </a>
      <div class="max-w-[420px]">
        <h2 class="font-display font-light text-4xl md:text-5xl text-forest mb-10 leading-tight">One-to-One</h2>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <p>
            Whether you're recovering from injury, burnout, training for a specific goal, or simply looking to move and feel better in everyday life, the sessions meet you where you are.
          </p>
          <p>
            A one-to-one begins with a consultation - to understand where you are physically and mentally, what you're carrying, and what you're working towards.
          </p>
          <p>
            From there, we build a practice entirely around you: the appropriate activity, the most supportive movement, the optimal terrain, at the sweet spot pace.
          </p>
          <p>
            You receive full personal guidance throughout, with the program adapting as you progress.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Details (bg-white) -->
  <section class="bg-white py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-[5fr_7fr] gap-16 md:gap-24">
        <div>
          <div class="space-y-4">
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">Consultation</span>
              <span class="text-base text-forest font-light">500 NOK / 1h session</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">Up to 4 sessions</span>
              <span class="text-base text-forest font-light">1200 NOK / 2h session</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">5 or more</span>
              <span class="text-base text-forest font-light">1000 NOK / 2h session</span>
            </div>
            <div class="pt-12">
              <a
                href="/signup"
                class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
              >
                Sign up
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>
