---
// One page per trip. The page itself is in src/views/EveningResetTrip.astro, shared by both languages.
import EveningResetTrip from '../../../views/EveningResetTrip.astro';
import { tripPaths, type Session } from '../../../data/events';

export function getStaticPaths() {
  return tripPaths('evening-reset');
}

const { session } = Astro.props as { session: Session };
---

<EveningResetTrip session={session} />
