---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import heroNordkollen from '../images/hero-nordkollen.webp';
import skolapparn from '../images/skolapparn.webp';
import moss from '../images/moss.webp';
import noname2 from '../images/noname2.webp';
import eva from '../images/eva.webp';

const heroImage = await getImage({ src: heroNordkollen, width: 2000, format: 'webp' });
---

<Layout title="Rewild Yourself" description="Return to yourself through nature" ogTitle="Rewild Yourself" ogDescription="Return to yourself through nature" ogImage="/images/hero-nordkollen.webp" preloadImage={heroImage.src}>

  <!-- Navigation -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 px-6 py-5 md:px-12">
    <div class="max-w-6xl mx-auto flex items-center justify-end md:justify-center">
      <ul class="hidden md:flex gap-10 text-xs tracking-[0.3em] uppercase font-normal" id="nav-links">
        <li><a href="/" class="text-white hover:opacity-60 transition-opacity duration-200">Home</a></li>
        <li><a href="#events" class="text-white hover:opacity-60 transition-opacity duration-200">Events</a></li>
        <li><a href="#about" class="text-white hover:opacity-60 transition-opacity duration-200">About</a></li>
        <li><a href="/the-story" class="text-white hover:opacity-60 transition-opacity duration-200">The Story</a></li>
        <li><a href="/contact" class="text-white hover:opacity-60 transition-opacity duration-200">Contact</a></li>
      </ul>
      <button id="menu-btn" class="md:hidden text-white transition-colors duration-300" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-white flex flex-col items-center justify-center hidden">
    <button id="menu-close" class="absolute top-5 right-6 text-forest" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <ul class="flex flex-col gap-8 text-center">
      <li><a href="/" class="font-display text-[1.8rem] text-forest font-light mobile-link">Home</a></li>
      <li><a href="#events" class="font-display text-[1.8rem] text-forest font-light mobile-link">Events</a></li>
      <li><a href="#about" class="font-display text-[1.8rem] text-forest font-light mobile-link">About</a></li>
      <li><a href="/the-story" class="font-display text-[1.8rem] text-forest font-light mobile-link">The Story</a></li>
      <li><a href="/contact" class="font-display text-[1.8rem] text-forest font-light mobile-link">Contact</a></li>
    </ul>
  </div>

  <!-- Hero -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${heroImage.src}');`}
    ></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.72) 0%, rgba(20,25,14,0.3) 50%, rgba(20,25,14,0.15) 100%);"></div>
    <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
      <h1 class="font-light leading-none text-white flex flex-col items-center">
        <span class="block text-3xl md:text-4xl tracking-[0.3em] uppercase">Rewild</span>
      </h1>
      <p class="absolute inset-x-0 top-full mt-24 font-display font-normal italic text-white text-2xl leading-relaxed">
        Return to yourself, naturally.
      </p>
    </div>
    <div class="absolute bottom-8 right-8 md:right-12 text-white/40 flex items-center gap-3">
      <span class="w-10 h-px bg-white/30"></span>
      <span class="text-xs tracking-widest uppercase font-light">Scroll</span>
    </div>
  </section>

  <!-- Intro two-column -->
  <section class="bg-white pt-20 pb-20 md:pt-32 md:pb-32">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="md:max-w-2xl md:mx-auto">
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem] md:text-[1.28rem] text-center">
          <p>
            Rewild takes exercise into nature, helping you remember how to move freely, rest deeply and feel ridiculously alive.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Events -->
  <section id="events" class="bg-cream pt-10 pb-24 md:pt-24 md:pb-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <p class="text-xs tracking-[0.3em] uppercase text-forest mb-10 font-light">Events</p>
      <div class="grid md:grid-cols-3 gap-16 md:gap-8">

        <!-- Evening Reset -->
        <a href="/evening-reset" class="bg-white group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <Image
              src={skolapparn}
              alt="Evening Reset - forest hike"
              width={1200}
              densities={[1, 2]}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Hike & movement</p>
            <h3 class="font-display font-medium text-3xl text-forest mb-5 leading-tight">Evening Reset</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              <span class="text-sage-light font-semibold">October 2026</span> A weekly evening hike designed to help you release stress, build core strength, and move with greater awareness. Explore a new trail each week, in all weather and every season.
            </p>
            <div class="pt-5 border-t border-cream">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">
                Learn more →
              </span>
            </div>
          </div>
        </a>

        <!-- Deep Rest -->
        <a href="/deep-rest" class="bg-white group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <Image
              src={moss}
              alt="Deep Rest - guided relaxation"
              width={1200}
              densities={[1, 2]}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Guided relaxation</p>
            <h3 class="font-display font-medium text-3xl text-forest mb-5 leading-tight">Deep Rest</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              <span class="text-sage-light font-semibold">October 2026</span> A guided relaxation journey, helping you release tension after an intense day or high-activity period. Followed by a nourishing soup. Small groups, cosy atmosphere.
            </p>
            <div class="pt-5 border-t border-cream">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">Learn more →</span>
            </div>
          </div>
        </a>

        <!-- Rewild Trip -->
        <a href="/rewild-trip" class="bg-white group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <Image
              src={noname2}
              alt="Rewild Trip - full-day hike"
              width={1200}
              densities={[1, 2]}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Day hike</p>
            <h3 class="font-display font-medium text-3xl text-forest mb-5 leading-tight">Nordkollen Rewild</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              <span class="text-sage-light font-semibold">September 2026</span> A longer, wilder, daytime hike that takes you deeper into your core, movement and breath awareness. Expanded nature immersion with more time to be, sense and connect.
            </p>
            <div class="pt-5 border-t border-cream">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">
                Learn more →
              </span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="bg-white py-24 md:py-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid gap-6 md:grid-cols-2 md:gap-24 items-stretch">
        <div class="md:order-1 md:sticky md:top-32 self-start">
          <Image
            src={eva}
            alt="Ewa"
            width={1000}
            densities={[1, 2]}
            class="w-full h-auto aspect-square object-cover object-top"
            loading="lazy"
          />
        </div>
        <div class="md:order-2">
          <h2 class="font-display font-medium text-3xl md:text-4xl text-forest mb-10 leading-tight">
            Hey, I'm Ewa
          </h2>
          <div class="space-y-6 text-forest font-light leading-relaxed text-[1.08rem]">
            <p>
              I teach nature-based movement at Rewild.
            </p>
            <p>
              Growing up in the mountains of southern Poland, I trained a variety of disciplines from a young age - mainly slalom skiing, trail running, mountain biking, swimming, martial arts and basketball.
            </p>
            <p>
              This early immersion in sports gave me a practical understanding of the body and a deep passion for movement.
            </p>
            <p>
              I studied physical education in the UK, where I was introduced to yoga - mainly Ashtanga and Iyengar - and pilates.
            </p>
            <p>
              After several years of practice, I obtained Hatha yoga teacher certification in London, and Advanced Trauma-Informed Academy certification with Nordic Maha Yoga, Oslo.
            </p>
            <p>
              Plants are a major part of my life, and I've been studying herbalism formally and informally since 2009. I often share plant teas with the participants during hikes and recovery sessions.
            </p>
            <p>
              The actual story of Rewild goes back to the 80s, when being in nature was a part of daily life - training, foraging, and having a lot of freedom to play wild.
            </p>
            <p>
              Fast forward into my early thirties, I've experienced immense challenges that took almost a decade to recover from, leading to physical and mental burnout.
            </p>
            <p>
              Intuitively, I started to hike up local mountains straight after work, in all weather, infusing physical practices with sensory nature connection.
            </p>
            <p>
              The transformative effects of it were immediate, and it totally changed my life. You can read more about this process <a href="/the-story" class="font-semibold underline decoration-forest/40 hover:decoration-forest transition-colors duration-200">here</a>.
            </p>
            <p>
              I felt inspired to share these tools with others, leading to the creation of Rewild.
            </p>
            <p>
              My approach to exercise incorporates a variety of methods with an emphasis on functional movement, <a href="/deep-rest" class="font-semibold underline decoration-forest/40 hover:decoration-forest transition-colors duration-200">recovery</a> and injury prevention.
            </p>
            <p>
              In daily life, I spend a lot of time in nature - sleeping, training, healing, learning, exploring and being - it brings me back to balance, fills with life, beauty and inspiration.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>

<script>
  // Nav scroll behaviour
  const nav = document.getElementById('nav');
  const navLinks = document.getElementById('nav-links');
  const menuBtn = document.getElementById('menu-btn');

  const updateNav = () => {
    const scrolled = window.scrollY > 80;

    if (scrolled) {
      nav?.classList.add('bg-white/95', 'backdrop-blur-sm', 'shadow-sm');
      menuBtn?.classList.replace('text-white', 'text-forest');
      navLinks?.querySelectorAll('a').forEach(a => a.classList.replace('text-white', 'text-forest'));
    } else {
      nav?.classList.remove('bg-white/95', 'backdrop-blur-sm', 'shadow-sm');
      menuBtn?.classList.replace('text-forest', 'text-white');
      navLinks?.querySelectorAll('a').forEach(a => a.classList.replace('text-forest', 'text-white'));
    }
  };

  window.addEventListener('scroll', updateNav);
  updateNav();

  // Mobile menu
  const mobileMenu = document.getElementById('mobile-menu');
  const menuClose = document.getElementById('menu-close');

  const closeMobileMenu = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  };

  menuBtn?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('hidden')) {
      mobileMenu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      closeMobileMenu();
    }
  });

  menuClose?.addEventListener('click', closeMobileMenu);
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>
