---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import EventCalendar from '../components/EventCalendar.astro';
import heroJot from '../images/jot.webp';
import eva from '../images/eva.webp';

const heroImage = await getImage({ src: heroJot, width: 2000, format: 'webp' });
---

<Layout title="Rewild Yourself" description="Return to yourself through nature" ogTitle="Rewild Yourself" ogDescription="Return to yourself through nature" ogImage="/images/hero-nordkollen.webp" preloadImage={heroImage.src} preloadWordmarkFont>

  <!-- Navigation -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 px-6 py-5 md:px-0">
    <div class="max-w-6xl mx-auto md:px-12 flex items-center justify-end">
      <a href="#return-to-yourself" id="nav-wordmark" class="md:hidden absolute left-1/2 -translate-x-1/2 font-wordmark text-[11.75pt] tracking-[0.3em] uppercase font-light text-white transition-colors duration-300">Rewild</a>
      <ul class="hidden md:flex gap-10 text-xs tracking-[0.3em] uppercase font-normal" id="nav-links">
        <li><a href="/" class="text-white hover:opacity-60 transition-opacity duration-200">Rewild</a></li>
        <li><a href="#events" class="text-white hover:opacity-60 transition-opacity duration-200">Events</a></li>
        <li><a href="#about" class="text-white hover:opacity-60 transition-opacity duration-200">About</a></li>
        <li><a href="/the-story" class="text-white hover:opacity-60 transition-opacity duration-200">The Story</a></li>
        <li><a href="/one-to-one" class="text-white hover:opacity-60 transition-opacity duration-200">One-to-One</a></li>
        <li><a href="/contact" class="text-white hover:opacity-60 transition-opacity duration-200">Contact</a></li>
      </ul>
      <button id="menu-btn" class="md:hidden text-white transition-colors duration-300" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-white flex flex-col items-center justify-center hidden">
    <button id="menu-close" class="absolute top-5 right-6 text-forest" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <ul class="flex flex-col gap-8 text-center">
      <li><a href="/" class="font-display text-[1.8rem] text-forest font-light mobile-link">Home</a></li>
      <li><a href="#events" class="font-display text-[1.8rem] text-forest font-light mobile-link">Events</a></li>
      <li><a href="#about" class="font-display text-[1.8rem] text-forest font-light mobile-link">About</a></li>
      <li><a href="/the-story" class="font-display text-[1.8rem] text-forest font-light mobile-link">The Story</a></li>
      <li><a href="/one-to-one" class="font-display text-[1.8rem] text-forest font-light mobile-link">One-to-One</a></li>
      <li><a href="/contact" class="font-display text-[1.8rem] text-forest font-light mobile-link">Contact</a></li>
    </ul>
  </div>

  <!-- Hero -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${heroImage.src}');`}
    ></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.72) 0%, rgba(20,25,14,0.3) 50%, rgba(20,25,14,0.15) 100%);"></div>
    <div class="relative top-[92px] md:top-[80px] z-10 text-left w-full max-w-6xl mx-auto px-6 md:px-12">
      <h1 class="sr-only">Rewild</h1>
      <p class="font-display font-bold text-white text-[21.5pt] md:text-4xl leading-tight text-balance">
        Transform the way you move
      </p>
      <a href="#events" class="inline-block mt-6 md:mt-8 px-10 py-4 border border-white text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-white hover:text-black transition-colors duration-300">Join</a>
      <p class="mt-10 md:mt-28 max-w-2xl md:max-w-4xl font-display font-normal italic text-white/90 text-[16pt] md:text-[23pt] leading-relaxed text-balance">
        Rewild takes you on unique hikes that help you build strength and resilience through any terrain in life.
      </p>
    </div>
    <div class="absolute bottom-8 right-8 md:right-12 text-white/40 flex items-center gap-3">
      <span class="w-10 h-px bg-white/30"></span>
      <span class="text-xs tracking-widest uppercase font-light">Scroll</span>
    </div>
  </section>

  <!-- How we do it -->
  <section id="return-to-yourself" class="bg-white pt-16 pb-16 md:pt-28 md:pb-24 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-3 gap-x-12 gap-y-7 md:gap-y-10">
        <div>
          <h3 class="font-display font-bold text-3xl text-forest mb-3 leading-tight">Injury prevention</h3>
          <p class="read-more-text hidden text-forest font-light text-[1.08rem] leading-relaxed">
            Moving mindfully in terrain is an essential skill that protects your health. Learn walking techniques that minimise the risk of falls, joint injuries and back pain - whether in the city or on the trail.
          </p>
          <button type="button" class="read-more-btn mt-2 inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
        </div>
        <div>
          <h3 class="font-display font-bold text-3xl text-forest mb-3 leading-tight">Movement in terrain</h3>
          <p class="read-more-text hidden text-forest font-light text-[1.08rem] leading-relaxed">
            Unlike on flat ground, every step in terrain is a new problem to solve. Build balance, foot strength, coordination and body awareness to remain steady and improve response time.
          </p>
          <button type="button" class="read-more-btn mt-2 inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
        </div>
        <div>
          <h3 class="font-display font-bold text-3xl text-forest mb-3 leading-tight">Stress release</h3>
          <p class="read-more-text hidden text-forest font-light text-[1.08rem] leading-relaxed">
            Time in nature lowers stress, elevates mood and shifts your nervous system into rest and repair. This improves learning, health and mental performance. Learn sensory connection techniques that help you get more of those therapeutic effects.
          </p>
          <button type="button" class="read-more-btn mt-2 inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
        </div>
        <div>
          <h3 class="font-display font-bold text-3xl text-forest mb-3 leading-tight">Functional body</h3>
          <p class="read-more-text hidden text-forest font-light text-[1.08rem] leading-relaxed">
            Learn simple, practical ways to counteract the effects of prolonged sitting and build the foundations that enable you to maintain strength, balance and stability as you age.
          </p>
          <button type="button" class="read-more-btn mt-2 inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
        </div>
        <div>
          <h3 class="font-display font-bold text-3xl text-forest mb-3 leading-tight">Breath as a tool</h3>
          <p class="read-more-text hidden text-forest font-light text-[1.08rem] leading-relaxed">
            Your breath is the most direct tool you have to affect how you feel. Learn to use your breath to calm your nervous system, balance your mood and increase focus.
          </p>
          <button type="button" class="read-more-btn mt-2 inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
        </div>
        <div>
          <h3 class="font-display font-bold text-3xl text-forest mb-3 leading-tight">Resilience</h3>
          <p class="read-more-text hidden text-forest font-light text-[1.08rem] leading-relaxed">
            Exercise and exposure to the elements are each linked to stronger natural defences and greater resilience against stress. Combining them in nature amplifies the effect. This expands your capacity to handle stress in daily life.
          </p>
          <button type="button" class="read-more-btn mt-2 inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
        </div>
      </div>
      {/* Hidden for now (2026-10-24), kept to bring back later:
      <h2 class="mt-16 md:mt-24 font-display font-bold text-forest text-2xl md:text-4xl leading-tight text-balance">
        Nature gives us everything we need to live - and the ideal setting to restore balance in body and mind.
      </h2>
      */}
    </div>
  </section>

  <script>
    document.querySelectorAll('.read-more-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.previousElementSibling;
        const hidden = text.classList.toggle('hidden');
        btn.textContent = hidden ? 'More →' : 'Less ↑';
      });
    });
  </script>

  <!-- Events -->
  <section id="events" class="bg-cream pt-10 pb-4 md:pt-24 md:pb-16">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <p class="text-xs tracking-[0.3em] uppercase text-sage/80 mb-10 font-light">Events</p>
      <EventCalendar />
    </div>
  </section>

  <!-- About -->
  <section id="about" class="bg-white py-24 md:py-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid gap-10 md:grid-cols-2 md:gap-24 items-stretch">
        <div class="md:order-1 md:sticky md:top-32 self-start">
          <Image
            src={eva}
            alt="Ewa"
            width={1000}
            densities={[1, 2]}
            class="w-full h-auto aspect-square object-cover object-top"
            loading="lazy"
          />
        </div>
        <div class="md:order-2">
          <h2 class="font-display font-bold text-3xl md:text-4xl text-forest mb-6 md:mb-10 leading-tight">
            Hey! I'm Ewa
          </h2>
          <div class="space-y-6 text-forest font-light leading-relaxed text-[1.08rem]">
            <p>
              I teach nature-based movement at Rewild.
            </p>
            <div class="read-more-text hidden space-y-6">
              <p>
                Growing up in the mountains of southern Poland, with parents professionally in sports, I trained a variety of disciplines from a very young age.
              </p>
              <p>
                I studied physical education in the UK, where I was introduced to yoga, Pilates, and the biomechanics of injury prevention.
              </p>
              <p>
                I obtained Hatha Yoga Teacher certification in London, Advanced Trauma-Informed Academy certification with Nordic Maha Yoga, Oslo, and an Outdoor Yoga Guide in Wild Nature diploma with Marian Papp.
              </p>
              <p>
                The actual story of Rewild goes back to the 80s, when being in nature was a part of daily life - training, foraging, and having a lot of freedom to play wild.
              </p>
              <p>
                Fast forward a few decades, I experienced challenges that led to physical and mental burnout.
              </p>
              <p>
                I started to hike up local mountains, in all weather, infusing physical practices with sensory nature connection.
              </p>
              <p>
                The effects of it were immediate, and it totally changed my life. You can read more about this process <a href="/the-story" class="font-semibold underline decoration-forest/40 hover:decoration-forest transition-colors duration-200">here</a>.
              </p>
              <p>
                My approach to exercise focuses on injury prevention by reversing dysfunctional walking patterns, and through mindful movement, functional strength training and adequate recovery.
              </p>
              <p>
                I spend a lot of time in nature - sleeping, training, learning, off-trail hiking and simply being - it brings me back to balance, fills me with vitality and inspiration.
              </p>
            </div>
            <button type="button" class="read-more-btn inline-block font-sans text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>

<script>
  // Nav scroll behaviour
  const nav = document.getElementById('nav');
  const navLinks = document.getElementById('nav-links');
  const menuBtn = document.getElementById('menu-btn');
  const navWordmark = document.getElementById('nav-wordmark');

  const updateNav = () => {
    const scrolled = window.scrollY > 80;

    if (scrolled) {
      nav?.classList.add('bg-white/95', 'backdrop-blur-sm', 'shadow-sm');
      menuBtn?.classList.replace('text-white', 'text-forest');
      navWordmark?.classList.replace('text-white', 'text-forest');
      navLinks?.querySelectorAll('a').forEach(a => a.classList.replace('text-white', 'text-forest'));
    } else {
      nav?.classList.remove('bg-white/95', 'backdrop-blur-sm', 'shadow-sm');
      menuBtn?.classList.replace('text-forest', 'text-white');
      navWordmark?.classList.replace('text-forest', 'text-white');
      navLinks?.querySelectorAll('a').forEach(a => a.classList.replace('text-forest', 'text-white'));
    }
  };

  window.addEventListener('scroll', updateNav);
  updateNav();

  // Mobile menu
  const mobileMenu = document.getElementById('mobile-menu');
  const menuClose = document.getElementById('menu-close');

  const closeMobileMenu = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  };

  menuBtn?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('hidden')) {
      mobileMenu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      closeMobileMenu();
    }
  });

  menuClose?.addEventListener('click', closeMobileMenu);
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>
