---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rewild - Through nature" description="Return to yourself through nature" ogTitle="Return to yourself" ogDescription="through nature" ogImage="/images/hero-nordkollen.webp">

  <!-- Navigation -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 px-6 py-5 md:px-12">
    <div class="max-w-6xl mx-auto grid grid-cols-3 items-center md:flex md:justify-between">
      <div class="md:hidden"></div>
      <a href="#" class="text-xs tracking-[0.3em] uppercase font-light text-white transition-colors duration-300 justify-self-center md:justify-self-auto" id="nav-logo">Rewild</a>
      <ul class="hidden md:flex gap-10 text-xs tracking-[0.3em] uppercase font-normal" id="nav-links">
        <li><a href="#philosophy" class="text-white hover:opacity-60 transition-opacity duration-200">Philosophy</a></li>
        <li><a href="#events" class="text-white hover:opacity-60 transition-opacity duration-200">Events</a></li>
        <li><a href="/about" class="text-white hover:opacity-60 transition-opacity duration-200">About</a></li>
        <li><a href="/contact" class="text-white hover:opacity-60 transition-opacity duration-200">Contact</a></li>
      </ul>
      <button id="menu-btn" class="md:hidden text-white transition-colors duration-300 justify-self-end" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-white flex flex-col items-center justify-center hidden">
    <button id="menu-close" class="absolute top-5 right-6 text-forest" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <ul class="flex flex-col gap-8 text-center">
      <li><a href="#philosophy" class="font-display text-[1.8rem] text-forest font-light mobile-link">Philosophy</a></li>
      <li><a href="#events" class="font-display text-[1.8rem] text-forest font-light mobile-link">Events</a></li>
      <li><a href="/about" class="font-display text-[1.8rem] text-forest font-light mobile-link">About</a></li>
      <li><a href="/contact" class="font-display text-[1.8rem] text-forest font-light mobile-link">Contact</a></li>
    </ul>
  </div>

  <!-- Hero -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/hero-nordkollen.webp');"
    ></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.72) 0%, rgba(20,25,14,0.3) 50%, rgba(20,25,14,0.15) 100%);"></div>
    <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
      <h1 class="font-light leading-none text-white flex flex-col items-center">
        <span class="block text-3xl md:text-4xl tracking-[0.3em] uppercase">Rewild</span>
      </h1>
    </div>
    <div class="absolute bottom-8 right-8 md:right-12 text-white/40 flex items-center gap-3">
      <span class="w-10 h-px bg-white/30"></span>
      <span class="text-xs tracking-widest uppercase font-light">Scroll</span>
    </div>
  </section>

  <!-- Intro strip -->
  <div class="bg-white pt-10 pb-10 px-6 text-center">
    <p class="font-display font-light italic text-forest text-xl md:text-2xl lg:text-3xl leading-relaxed max-w-2xl mx-auto">
      Return to yourself, naturally.
    </p>
  </div>

  <!-- Intro two-column -->
  <section class="bg-cream py-24 md:py-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-2 md:gap-24">
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <p>
            Your ancestors didn't survive ice ages by doing bicep curls under fluorescent lighting.
          </p>
          <p>
            They used their acute senses, moved through every type of terrain, in all seasons, all weather.
          </p>
          <p>
            Rewild helps your body remember what it's actually for - moving fully, breathing deeply, and feeling ridiculously alive.
          </p>
        </div>
        <div></div>
      </div>
    </div>
  </section>

  <!-- Grow like a weed -->
  <section id="philosophy" class="bg-white py-24 md:py-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-2 gap-16 md:gap-24 items-stretch">
        <div>
          <img
            src="/images/waterflow.webp"
            alt="Connected with the earth"
            class="w-full h-full min-h-[400px] object-cover object-center"
            loading="lazy"
          />
        </div>
        <div>
          <h2 class="font-display font-light text-4xl md:text-5xl text-forest mb-10 leading-tight">
            You were built for this
          </h2>
          <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
            <p>
              Step into nature and within minutes, cortisol begins to drop, the mind quietens, and the nervous system shifts into repair mode.
            </p>
            <p>
              Time in nature does more than relax you, it restores you.
            </p>
            <p>
              Picture yourself being in a forest.
            </p>
            <p>
              The sweet scent of the earth.
            </p>
            <p>
              The sound of leaves all around.
            </p>
            <p>
              It feels good, doesn't it?
            </p>
            <p>
              Being among trees lowers anxiety, sharpens memory, and boosts immunity.
            </p>
            <p>
              Water revitalises, sunlight regulates sleep, and being outdoors actually makes social interactions easier.
            </p>
            <p>
              Your body carries millions of years of adaptation to this environment - to move freely, rest deeply and feel fiercely alive.
            </p>
            <p>
              As distant as it may seem, that capacity is still within you.
            </p>
            <p>
              Rewild is about waking it up.
            </p>
            <p>
              By reminding you of <em>your</em> nature.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Events -->
  <section id="events" class="bg-cream py-24 md:py-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <p class="text-xs tracking-[0.3em] uppercase text-forest mb-10 font-light">Events</p>
      <div class="grid md:grid-cols-3 gap-16 md:gap-8">

        <!-- Evening Reset -->
        <a href="/evening-reset" class="bg-white group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <img
              src="/images/skolapparn.webp"
              alt="Evening Reset - forest hike"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Hike & movement</p>
            <h3 class="font-display font-light text-3xl text-forest mb-5 leading-tight">Evening Reset</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              A weekly evening hike designed to help you release stress, build core strength, and move with greater awareness. Explore a new trail each week, in all weather and every season.
            </p>
            <div class="pt-5 border-t border-cream">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">
                Learn more →
              </span>
            </div>
          </div>
        </a>

        <!-- Deep Rest -->
        <a href="/deep-rest" class="bg-white group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <img
              src="/images/moss.webp"
              alt="Deep Rest - guided relaxation"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Guided relaxation</p>
            <h3 class="font-display font-light text-3xl text-forest mb-5 leading-tight">Deep Rest</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              A guided relaxation journey, helping you release tension after an intense day or high-activity period. Followed by a nourishing soup. Small groups, cosy atmosphere.
            </p>
            <div class="pt-5 border-t border-cream">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">Learn more →</span>
            </div>
          </div>
        </a>

        <!-- Nordkollen Rewild Trip -->
        <a href="/nordkollen-rewild-trip" class="bg-white group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <img
              src="/images/trees.webp"
              alt="Nordkollen Rewild Trip - full-day hike"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Day trip</p>
            <h3 class="font-display font-light text-3xl text-forest mb-5 leading-tight">Nordkollen Rewild</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              A longer, wilder, daytime hike that takes you deeper into your core, movement and breath awareness. Expanded nature immersion with more time to be, sense and connect.
            </p>
            <div class="pt-5 border-t border-cream">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">
                Learn more →
              </span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-forest text-white py-14 px-6">
    <div class="max-w-6xl mx-auto flex flex-col items-center gap-2 text-center">
      <p class="text-white/30 text-xs font-light">© 2025 Rewild</p>
    </div>
  </footer>

</Layout>

<script>
  // Nav scroll behaviour
  const nav = document.getElementById('nav');
  const navLogo = document.getElementById('nav-logo');
  const navLinks = document.getElementById('nav-links');
  const menuBtn = document.getElementById('menu-btn');

  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 80;

    if (scrolled) {
      nav?.classList.add('bg-white/95', 'backdrop-blur-sm', 'shadow-sm');
      navLogo?.classList.replace('text-white', 'text-forest');
      menuBtn?.classList.replace('text-white', 'text-forest');
      navLinks?.querySelectorAll('a').forEach(a => a.classList.replace('text-white', 'text-forest'));
    } else {
      nav?.classList.remove('bg-white/95', 'backdrop-blur-sm', 'shadow-sm');
      navLogo?.classList.replace('text-forest', 'text-white');
      menuBtn?.classList.replace('text-forest', 'text-white');
      navLinks?.querySelectorAll('a').forEach(a => a.classList.replace('text-forest', 'text-white'));
    }
  });

  // Mobile menu
  const mobileMenu = document.getElementById('mobile-menu');
  const menuClose = document.getElementById('menu-close');

  const closeMobileMenu = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  };

  menuBtn?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('hidden')) {
      mobileMenu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      closeMobileMenu();
    }
  });

  menuClose?.addEventListener('click', closeMobileMenu);
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>
