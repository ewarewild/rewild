---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Sign up - Rewild" description="Sign up for an Evening Reset, Deep Rest, or the Nordkollen Rewild Trip with Rewild.">

  <!-- Navigation -->
  <Nav />

  <!-- Form section -->
  <section class="bg-cream min-h-screen pt-32 pb-40 md:pt-44 md:pb-56">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <a href="/" class="inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-forest/60 hover:text-forest transition-colors duration-200 mb-12">
        <span>←</span><span>Home</span>
      </a>
      <div class="max-w-xl">
        <h1 class="font-display font-light text-5xl md:text-6xl text-forest mb-14 leading-tight">Sign up</h1>

        <form
          id="signup-form"
          class="space-y-6"
        >
          <input type="hidden" name="access_key" value="ee1b8b87-7dbe-406e-b5e5-3bb4cabe5ec4" />
          <input type="hidden" name="subject" value="New Rewild sign up" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Name</label>
            <input
              type="text"
              id="name"
              name="Name"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div>
            <label for="email" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Email address</label>
            <input
              type="email"
              id="email"
              name="Email"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div>
            <label for="phone" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Telephone number</label>
            <input
              type="tel"
              id="phone"
              name="Telephone"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div class="relative">
            <label for="event" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Event</label>
            <select
              id="event"
              name="Offering"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 appearance-none cursor-pointer"
            >
              <option value="" disabled selected></option>
              <option value="Evening Reset Skien">Evening Reset - Skien</option>
              <option value="Evening Reset Porsgrunn">Evening Reset - Porsgrunn</option>
              <option value="Evening Reset Larvik">Evening Reset - Larvik</option>
              <option value="Evening Reset Sandefjord">Evening Reset - Sandefjord</option>
              <option value="Nordkollen Rewild Trip">Nordkollen Rewild Trip</option>
              <option value="Deep Rest Porsgrunn">Deep Rest - Porsgrunn</option>
            </select>
            <span class="pointer-events-none absolute right-4 top-[2.85rem] text-forest/40">↓</span>
          </div>

          <div id="why-field">
            <label for="why" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">What inspired you to join this event?</label>
            <textarea
              id="why"
              name="Why"
              rows="4"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <div id="injuries-field">
            <label for="injuries" class="block text-xs tracking-[0.2em] uppercase text-forest font-light mb-3">Do you have any injuries or health conditions that might affect physical activity?</label>
            <textarea
              id="injuries"
              name="Injuries or health conditions"
              rows="4"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <div class="pt-4">
            <button
              id="signup-submit"
              type="submit"
              class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
            >
              Send
            </button>
            <p class="text-base text-sage font-light mt-4">Your details will not be shared with anyone</p>
            <p id="signup-status" class="text-sm font-light mt-4" role="status"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-forest text-white py-14 px-6">
    <div class="max-w-6xl mx-auto flex flex-col items-center gap-2 text-center">
      <p class="text-white/30 text-xs font-light">© 2025 Rewild</p>
    </div>
  </footer>

</Layout>

<script>
  const eventSelect = document.getElementById('event') as HTMLSelectElement;
  const injuriesField = document.getElementById('injuries-field') as HTMLElement;
  const injuriesTextarea = document.getElementById('injuries') as HTMLTextAreaElement;

  eventSelect?.addEventListener('change', () => {
    const isDeepRest = eventSelect.value.startsWith('Deep Rest');
    injuriesField.style.display = isDeepRest ? 'none' : 'block';
    injuriesTextarea.required = !isDeepRest;
  });

  const form = document.getElementById('signup-form') as HTMLFormElement;
  const submitButton = document.getElementById('signup-submit') as HTMLButtonElement;
  const statusEl = document.getElementById('signup-status') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    statusEl.textContent = '';

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        statusEl.textContent = "Thank you - we've received your details and will be in touch soon.";
        statusEl.className = 'text-sm font-light mt-4 text-sage';
      } else {
        statusEl.textContent = 'Something went wrong sending your details. Please try again in a moment.';
        statusEl.className = 'text-sm font-light mt-4 text-red-700';
      }
    } catch {
      statusEl.textContent = 'Something went wrong sending your details. Please try again in a moment.';
      statusEl.className = 'text-sm font-light mt-4 text-red-700';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send';
    }
  });
</script>
