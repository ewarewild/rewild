---
import { heroImage as heroPhoto } from '../../lib/hero';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import skolapparn from '../../images/skolapparn.webp';
import { events, tripPaths, longDate, signupLabel, price, type Session } from '../../data/events';

export function getStaticPaths() {
  return tripPaths('evening-reset');
}

interface Props {
  session: Session;
}

const { session } = Astro.props;
const name = events['evening-reset'].name;

const heroImage = await heroPhoto(skolapparn, 65);
---

<Layout title={`${name} - ${session.spot ?? session.place} - Rewild`} description="A headlamp hike through the dark months - breath, silence and the senses. Now in Skien, Porsgrunn, Larvik and Sandefjord." preloadImage={heroImage}>

  <!-- Navigation -->
  <Nav />

  <!-- Hero image -->
  <section class="relative mt-[60px] overflow-hidden" style="height: 65vh;">
    <img
      src={heroImage.src}
      srcset={heroImage.srcset}
      sizes={heroImage.sizes}
      alt=""
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover" style="object-position: center 25%;"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.5) 0%, transparent 60%);"></div>
    <a href="/#events" class="absolute top-6 left-6 md:left-12 inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-white hover:opacity-70 transition-opacity duration-200">
      <span>←</span><span>All events</span>
    </a>
  </section>

  <!-- Title strip (bg-white) -->
  <div class="bg-white py-10 px-6 text-center">
    <p class="font-display font-normal italic text-forest text-[16pt] md:text-[20.5pt] lg:text-[25pt] leading-relaxed max-w-2xl mx-auto">The moment you step into trees, something shifts. The mind quietens. Your guard drops, tension releasing, something opening. You feel more awake.</p>
  </div>

  <!-- Intro section (bg-cream, matching 'You were built for this') -->
  <section class="bg-cream pt-16 md:pt-24 pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h2 class="font-display font-bold text-4xl md:text-5xl text-forest mb-10 leading-tight">{name} - {session.spot ?? session.place}</h2>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          {(session.intro ?? ['Welcome to an exciting hike in local nature, designed to help you shake off the day and reconnect with your body while taking the strain off your joints. The trip is focused on stress release, as well as building strength and stability as you walk.']).map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What we'll do strip (bg-white, full width) -->
  <div class="bg-white pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight mb-6">What we'll do:</h3>
        <div class="space-y-6">
          {[
            'Use breath to focus attention in the body and calm our nervous system',
            'Stop along the way to check in with ourselves through our senses',
            'Do walking exercises that counteract imbalances caused by prolonged sitting',
            'Slow down on the descents and use walking techniques that take the strain off the joints',
          ].map(item => (
            <div class="flex items-start gap-4">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
              <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <section class="bg-cream pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight">Who is it for?</h3>
          <div class="space-y-6">
            {[
              'People who enjoy movement and want to decompress at the end of the day',
              "People who don't have the time to be in nature or exercise daytime",
              'People looking to boost their everyday energy levels',
              'People dealing with back pain from prolonged sitting',
            ].map(item => (
              <div class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
                <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Practical info (bg-white) -->
  <section class="bg-white pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest mb-10 leading-tight">Technical info:</h3>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <p>
            No previous experience is needed, though you should be comfortable maintaining a faster pace on the way up.
          </p>
          <p>
            The event is held in English.
          </p>
          <p>
            Please <a href="/contact" class="font-semibold underline hover:text-sage transition-colors duration-200">get in touch</a> if you have any questions.
          </p>
        </div>
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight mt-12 mb-6">What to bring:</h3>
        <div class="space-y-6">
          {[
            'Headlamp',
            'Walking shoes with a good grip',
            'Appropriate clothes for the weather',
            'Water',
            'Hiking poles (optional)',
            'Snack (optional)',
          ].map(item => (
            <div class="flex items-start gap-4">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
              <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
        <p class="text-forest text-[1.08rem] font-light leading-relaxed mt-5">
          We hike in most weather, however, if hazardous conditions arise, the hike will be cancelled. You will receive a full refund or an option to rebook your trip.
        </p>
      </div>
    </div>
  </section>

  <!-- Details (bg-cream) -->
  <section class="bg-cream pt-12 md:pt-[72px] pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-[5fr_7fr] gap-16 md:gap-24">
        <div>
          <!-- Details -->
          <div class="space-y-4">
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Duration</span>
              <span class="text-base text-forest font-light">{session.duration ?? 'Approx 1.5 hours'}</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Date</span>
              <span class="text-base text-forest font-light">{longDate(session)}</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Meet up</span>
              <span class="text-base text-forest font-light">{session.time}</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Meeting point</span>
              <span class="text-base text-forest font-light">
                {session.mapUrl
                  ? <a href={session.mapUrl} target="_blank" rel="noopener" class="font-semibold underline hover:text-sage transition-colors duration-200">{session.meetingPoint}</a>
                  : session.meetingPoint ?? 'To be announced'}
              </span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Price</span>
              <span class="text-base text-forest font-light">{price(session)} NOK</span>
            </div>
            <div class="pt-12">
              <a
                href={`/signup?event=${encodeURIComponent(signupLabel(session))}`}
                class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
              >
                Sign up
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>
