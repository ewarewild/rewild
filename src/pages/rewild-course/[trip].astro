---
// One page per trip. The page itself is in src/views/RewildCourseTrip.astro, shared by both languages.
import RewildCourseTrip from '../../views/RewildCourseTrip.astro';
import { tripPaths, type Session } from '../../data/events';

export function getStaticPaths() {
  return tripPaths('rewild-course');
}

const { session } = Astro.props as { session: Session };
---

<RewildCourseTrip session={session} />
