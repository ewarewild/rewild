---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import nordkollen2 from '../../images/nordkollen2.webp';
import { events, tripPaths, longDate, signupLabel, type Session } from '../../data/events';

export function getStaticPaths() {
  return tripPaths('rewild-course');
}

interface Props {
  session: Session;
}

const { session } = Astro.props;
const name = events['rewild-course'].name;

const heroImage = await getImage({ src: session.image ?? nordkollen2, width: 2000, format: 'webp' });
---

<Layout title={`${name} - ${session.spot ?? session.place} - Rewild`} description="A full day course up Nordkollen, built around five modules: injury prevention, core strength, focus and awareness, stress release & recovery, and building resilience." preloadImage={heroImage.src}>

  <!-- Navigation -->
  <Nav />

  <!-- Hero image -->
  <section class="relative mt-[60px] overflow-hidden" style="height: 65vh;">
    <div
      class="absolute inset-0 bg-cover bg-no-repeat"
      style={`background-image: url('${heroImage.src}'); background-position: center center;`}
    ></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.5) 0%, transparent 60%);"></div>
    <a href="/#events" class="absolute top-6 left-6 md:left-12 inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-white/60 hover:text-white transition-colors duration-200">
      <span>←</span><span>All events</span>
    </a>
  </section>

  <!-- Title strip (bg-white) -->
  <div class="bg-white py-10 px-6 text-center">
    <p class="font-display font-normal italic text-forest text-[16pt] md:text-[20.5pt] lg:text-[25pt] leading-relaxed max-w-2xl mx-auto">A day in nature gives you time to properly arrive and let the nervous system unwind.</p>
  </div>

  <!-- Intro section (bg-cream, matching 'You were built for this') -->
  <section class="bg-cream pt-16 md:pt-24 pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h2 class="font-display font-bold text-4xl md:text-5xl text-forest mb-10 leading-tight">{name} - {session.spot ?? session.place}</h2>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          {session.intro ? session.intro.map(paragraph => <p set:html={paragraph} />) : (
            <>
              <p>
                Welcome to a day of practical training in nature that gives you tools to move safely, build core strength, and recover better - on the trail, and in everyday life.
              </p>
              <p>
                We hike to <a href="https://www.google.com/maps?q=59.197427717465644,9.8402239222746" target="_blank" rel="noopener" class="underline hover:text-sage transition-colors duration-200">Nordkollen</a>, a mountain near Porsgrunn, to immerse ourselves in wild nature.
              </p>
            </>
          )}
          <p>
            We alternate between physically challenging our bodies, and more relaxing practices, taking time to rest and unwind.
          </p>
          <p class="pt-[28px] md:pt-[36px]">
            The course is built around five modules:
          </p>
          <div class="space-y-6 pt-[16px] md:pt-[24px]">
            {[
              'Injury prevention',
              'Core strength',
              'Focus and awareness',
              'Stress release & recovery',
              'Building resilience',
            ].map(item => (
              <div class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
                <span class="text-[1.08rem] text-forest font-semibold leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What you'll learn strip (bg-white, full width) -->
  <div class="bg-white pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight mb-6">You'll learn:</h3>
        <div class="space-y-6">
          {[
            'How to walk in terrain to reduce strain on your feet, ankles, knees, hips and back, and minimise the risk of falling and injuries.',
            'How to use terrain as a tool for training to counteract the negative effects of prolonged sitting.',
            'Simple breathing techniques to improve focus and mental balance, and optimise breathing during exercise.',
            'How to connect with nature through your senses to lower stress, increase focus and elevate your mood.',
            'How to use exposure to the elements as a tool to build resilience to stress and support your body\'s natural defences.',
          ].map(item => (
            <div class="flex items-start gap-4">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
              <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
        <p class="text-forest font-light text-[1.08rem] leading-relaxed pt-[28px] md:pt-[36px]">
          On top of the mountain, we take time to rest, chat, enjoy a packed lunch and a tea.
        </p>
      </div>
    </div>
  </div>

  <section class="bg-cream pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight">Who is it for?</h3>
          <div class="space-y-6">
            {[
              'People who want to train smarter on the trail, instead of just walking it',
              'People who enjoy being outdoors and want to protect their joints in terrain',
              'People looking to boost their energy levels for everyday tasks',
              'Those considering barefoot shoes, or who already use them and experience foot pain',
              'Anyone who deals with joint or back pain from hours of sitting',
              'People curious about using breath to focus, relieve stress and increase energy during exercise',
            ].map(item => (
              <div class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
                <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Practical info (bg-white) -->
  <section class="bg-white pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest mb-10 leading-tight">Technical info:</h3>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          {session.meetUp ? <p set:html={session.meetUp} /> : (
            <p>
              We meet up at a parking space in <a href="https://www.google.com/maps?q=59.18604216274942,9.803863873385133" target="_blank" rel="noopener" class="underline hover:text-sage transition-colors duration-200">Oklungen</a> and walk from there on a gravel road, then on a forest trail.
            </p>
          )}
          {session.routeInfo ? <p set:html={session.routeInfo} /> : (
            <p>
              The total distance both ways is 7km, mostly easy but moderately demanding on the main climb.
            </p>
          )}
          <p>
            Including practice and breaks, total time is up to 5 hours.
          </p>
          <p>
            No previous experience is needed, but you should be comfortable maintaining a steady pace for the duration of the hike.
          </p>
          <p>
            The event is held in English.
          </p>
          <p>
            Please <a href="/contact" class="underline hover:text-sage transition-colors duration-200">get in touch</a> if you have any questions.
          </p>
          <p>
            Full practical details will be sent once you've booked your place.
          </p>
        </div>
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight mt-12 mb-6">What to bring:</h3>
        <div class="space-y-6">
          {[
            'Appropriate clothes for the weather',
            'Comfortable shoes with a grip',
            'Min 1 litre of water',
            'A packed lunch',
            'Small notepad and pen',
            'Seating mat',
            'Walking poles (optional)',
            'Hot tea (optional)',
          ].map(item => (
            <div class="flex items-start gap-4">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
              <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
        <p class="text-forest text-[1.08rem] font-light leading-relaxed mt-5">
          We hike in most weather, however, if hazardous conditions arise, the hike will be cancelled. You will receive a full refund or an option to rebook your trip.
        </p>
      </div>
    </div>
  </section>

  <!-- Details (bg-cream) -->
  <section class="bg-cream pt-12 md:pt-[72px] pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-[5fr_7fr] gap-16 md:gap-24">
        <div>
          <!-- Details -->
          <div class="space-y-4">
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Duration</span>
              <span class="text-base text-forest font-light">{session.duration ?? 'Up to 5 hours'}</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Date</span>
              <span class="text-base text-forest font-light">{longDate(session)}</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Meet up</span>
              <span class="text-base text-forest font-light">{session.time}</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Meeting point</span>
              <span class="text-base text-forest font-light">
                {session.mapUrl
                  ? <a href={session.mapUrl} target="_blank" rel="noopener" class="underline hover:text-sage transition-colors duration-200">{session.meetingPoint}</a>
                  : session.meetingPoint ?? 'To be announced'}
              </span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">Price</span>
              <span class="text-base text-forest font-light">{session.price ?? '300 NOK'}</span>
            </div>

            <div class="pt-12">
              <a
                href={`/signup?event=${encodeURIComponent(signupLabel(session))}`}
                class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
              >
                Sign up
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>
