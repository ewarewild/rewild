---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import skolapparn from '../images/skolapparn.webp';
import moss from '../images/moss.webp';
import nordkollen2 from '../images/nordkollen2.webp';

const heroImage = await getImage({ src: skolapparn, width: 2000, format: 'webp' });
---

<Layout title="Evening Reset - Rewild" description="A headlamp hike through the dark months - breath, silence and the senses. Now in Skien, Porsgrunn, Larvik and Sandefjord." preloadImage={heroImage.src}>

  <!-- Navigation -->
  <Nav />

  <!-- Hero image -->
  <section class="relative mt-[60px] overflow-hidden" style="height: 65vh;">
    <div
      class="absolute inset-0 bg-cover bg-no-repeat"
      style={`background-image: url('${heroImage.src}'); background-position: center 25%;`}
    ></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.5) 0%, transparent 60%);"></div>
    <a href="/#events" class="absolute top-6 left-6 md:left-12 inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-white/60 hover:text-white transition-colors duration-200">
      <span>←</span><span>All events</span>
    </a>
  </section>

  <!-- Title strip (bg-white) -->
  <div class="bg-white py-10 px-6 text-center">
    <p class="font-display font-normal italic text-forest text-2xl md:text-3xl lg:text-4xl leading-relaxed max-w-2xl mx-auto">The moment you step into trees, something shifts. The mind quietens. Your guard drops, tension releasing, something opening. You feel more awake.</p>
  </div>

  <!-- Intro section (bg-cream, matching 'You were built for this') -->
  <section class="bg-cream pt-16 md:pt-24 pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h2 class="font-display font-medium text-4xl md:text-5xl text-forest mt-6 mb-10 leading-tight">Evening Reset</h2>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <p>
            Welcome to an evening hike designed to take you out of your head and into your body. Perfect after a day of screens, thinking and talking, to bring you back into your senses.
          </p>
          <p class="pt-[28px] md:pt-[36px]">
            Each walk is designed around supporting:
          </p>
          <div class="space-y-6 pt-[16px] md:pt-[24px]">
            {[
              'Injury prevention',
              'Core and leg strength',
              'Stress release',
              'Focus and energy',
              'Better sleep',
            ].map(label => (
              <div class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
                <span class="text-[1.08rem] text-forest font-semibold leading-relaxed">{label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- You'll learn strip (bg-white, full width) -->
  <div class="bg-white pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight mb-6">What you'll learn:</h3>
        <div class="space-y-6">
          {[
            'Practical techniques to reduce the risk of falls and injuries while walking in terrain.',
            'How to make the most of the walk to strengthen your core, balance and improve posture.',
            'How to use breath to focus, calm your nervous system and get more energy during exercise.',
          ].map(item => (
            <div class="flex items-start gap-4">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
              <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight mt-12 mb-6">What we'll do:</h3>
        <div class="space-y-6">
          {[
            'Alternate between physically challenging our bodies and more relaxing practices.',
            'Pause several times to connect with nature through our senses.',
            'Take time to share a herbal tea, chat and connect.',
            'Explore different trails over four weeks in October.',
          ].map(item => (
            <div class="flex items-start gap-4">
              <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
              <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <section class="bg-cream pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <h3 class="font-display font-medium text-3xl md:text-4xl text-forest leading-tight">Who is it for?</h3>
          <div class="space-y-6">
            {[
              'People who want to train smarter on the trail, instead of just walking it',
              'Anyone who enjoys being outdoors and wants to learn a safe way to walk in terrain',
              'People looking to boost their energy levels for everyday tasks',
              'Anyone who deals with back, joint or posture strain from long hours of sitting',
              'Anyone who struggles to wind down in the evening and to fall asleep',
            ].map(item => (
              <div class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-sage-light flex-shrink-0"></span>
                <span class="text-[1.08rem] text-forest font-light leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Practical info (bg-white) -->
  <section class="bg-white pt-12 md:pt-[72px] pb-12 md:pb-[72px]">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h3 class="font-display font-medium text-3xl md:text-4xl text-forest mb-10 leading-tight">Technical info:</h3>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          <p>
            No previous experience is needed, though you should be comfortable maintaining a steady pace on an easy to medium difficulty trail for about 40 minutes.
          </p>
          <p>
            Please get in touch if you have any questions.
          </p>
          <p>
            What to bring: Appropriate clothes for the weather and water. Tea will be provided.
          </p>
          <p>
            Full practical details will be sent once you've booked your place. The parking place for each trip is up to a 10-20 min drive from the town centre of your region.
          </p>
        </div>
        <p class="text-forest/60 text-[1.08rem] font-light leading-relaxed mt-5">
          Please note: the exact location of every hike will be confirmed the day before to optimise the trail type for current weather and light conditions. We hike in all weather, however, if hazardous conditions arise, the hike will be cancelled. You will then be offered a free rebooking of your trip.
        </p>
        <p class="text-forest/60 text-[1.08rem] font-light leading-relaxed mt-4">
          To keep the group calm and focused, dogs aren't able to join this event.
        </p>
      </div>
    </div>
  </section>

  <!-- Details (bg-cream) -->
  <section class="bg-cream pt-12 md:pt-[72px] pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-[5fr_7fr] gap-16 md:gap-24">
        <div>
          <!-- Details -->
          <div class="space-y-4">
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">Duration</span>
              <span class="text-base text-forest font-light">Approx 1.5 hours</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">Meet up</span>
              <span class="text-base text-forest font-light">17:00</span>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">Location</span>
              <div class="text-base text-forest font-light space-y-1">
                <p>Skien - Mondays</p>
                <p>Porsgrunn - Tuesdays</p>
                <p>Larvik - Wednesdays</p>
                <p>Sandefjord - Thursdays</p>
              </div>
            </div>
            <div class="flex gap-6">
              <span class="text-xs tracking-[0.2em] uppercase text-sage font-light w-28 flex-shrink-0">Price</span>
              <div>
                <span class="text-base text-forest font-light">2000 NOK / 4 hikes - 1 month</span>
                <p class="text-sage text-xs tracking-[0.15em] uppercase font-light mt-2">30% off for new members in October</p>
              </div>
            </div>
            <div class="pt-12">
              <a
                href="/signup"
                class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
              >
                Sign up
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- More events -->
  <section class="bg-white pt-10 pb-24 md:pt-14 md:pb-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <p class="text-xs tracking-[0.3em] uppercase text-forest mb-10 font-light">More events</p>
      <div class="grid md:grid-cols-2 gap-16 md:gap-8">

        <!-- Deep Rest -->
        <a href="/deep-rest" class="bg-cream group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <Image
              src={moss}
              alt="Deep Rest - guided relaxation"
              width={1200}
              densities={[1, 2]}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Guided relaxation</p>
            <h3 class="font-display font-medium text-3xl text-forest mb-5 leading-tight">Deep Rest</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              <span class="text-sage-light font-semibold">October 2026</span> A guided relaxation journey, helping you release tension after an intense day or high-activity period. Includes a nourishing soup. Small groups, cosy atmosphere.
            </p>
            <div class="pt-5 border-t border-white">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">Learn more →</span>
            </div>
          </div>
        </a>

        <!-- Rewild Trip -->
        <a href="/rewild-trip" class="bg-cream group overflow-hidden block cursor-pointer">
          <div class="overflow-hidden h-72">
            <Image
              src={nordkollen2}
              alt="Rewild Day Course - full-day training"
              width={1200}
              densities={[1, 2]}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-8">
            <p class="text-xs tracking-[0.3em] uppercase text-sage mb-3 font-light">Course</p>
            <h3 class="font-display font-medium text-3xl text-forest mb-5 leading-tight">Rewild Day Course</h3>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8">
              <span class="text-sage-light font-semibold">September 2026</span> A full day of practical training built around five core modules - injury prevention, core and leg strength, stress release & recovery, building resilience, and breath.
            </p>
            <div class="pt-5 border-t border-white">
              <span class="inline-block text-xs tracking-[0.25em] uppercase font-light text-forest group-hover:text-sage transition-colors duration-300">
                Learn more →
              </span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>
