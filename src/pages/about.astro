---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import eva from '../images/eva.webp';
---

<Layout title="About - Rewild" description="Meet Ewa, your guide at Rewild - grounded in nature, rooted in practice.">

  <!-- Navigation -->
  <Nav />

  <!-- About -->
  <section class="bg-white pt-36 pb-24 md:pt-44 md:pb-36">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid gap-6 md:grid-cols-2 md:gap-24 items-stretch">
        <div class="md:order-1 min-h-[400px]">
          <Image
            src={eva}
            alt="Ewa"
            width={1000}
            densities={[1, 2]}
            class="w-full h-full object-cover object-top"
            loading="lazy"
          />
        </div>
        <div class="md:order-2">
          <h2 class="font-display font-light text-3xl md:text-4xl text-forest mb-10 leading-tight">
            Hey, I'm Ewa
          </h2>
          <div class="space-y-6 text-forest font-light leading-relaxed text-[1.08rem]">
            <p>
              I teach nature-based movement at Rewild.
            </p>
            <p>
              I grew up in the mountains of southern Poland, training a variety of disciplines from an early age - mainly slalom skiing, trail running, mountain biking, swimming, martial arts and basketball.
            </p>
            <p>
              This early immersion in sports gave me a practical understanding of the body and a deep passion for nature, adventure and movement.
            </p>
            <p>
              I studied physical education in the UK, where I was introduced to yoga and pilates.
            </p>
            <p>
              After several years of practice, I obtained yoga teacher certification in London, and Advanced Trauma-Informed Academy certification with Nordic Maha Yoga, Oslo.
            </p>
            <p>
              My approach to exercise incorporates a variety of methods with an emphasis on functional movement and injury prevention.
            </p>
            <p>
              I spend a lot of time in nature - sleeping, training, healing, exploring - it brings me back to balance, fills with life, beauty and inspiration.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>
