---
import { langFromPath, localePath } from '../i18n';

const year = new Date().getFullYear();
const lang = langFromPath(Astro.url.pathname);
const t = lang === 'no'
  ? {
      instagram: 'Rewild på Instagram',
      facebook: 'Rewild på Facebook',
      disclaimer: 'Rewild tilbyr bevegelse og aktiviteter i naturen for helse og velvære. Ingenting på denne nettsiden eller i øktene er medisinske råd, diagnose eller behandling. Har du en skade eller en helsetilstand, bør du snakke med lege eller fysioterapeut før du blir med.',
      terms: 'Salgsvilkår',
    }
  : {
      instagram: 'Rewild on Instagram',
      facebook: 'Rewild on Facebook',
      disclaimer: 'Rewild offers movement and nature-based wellness activities. Nothing on this site or in the sessions constitutes medical advice, diagnosis, or treatment. If you have an injury or health condition, please consult a doctor or physiotherapist before participating.',
      terms: 'Terms of sale',
    };
---

<footer class="bg-forest text-white py-14 px-6">
  <div class="max-w-6xl mx-auto flex flex-col items-center gap-4 text-center">
    <div class="flex items-center gap-6">
      <a
        href="https://www.instagram.com/rewild.eva"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.instagram}
        class="text-white/50 hover:text-white transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a
        href="https://www.facebook.com/profile.php?id=61569362843137"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.facebook}
        class="text-white/50 hover:text-white transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3.5l1-4H14V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </a>
    </div>
    <p class="text-white/30 text-xs font-light max-w-2xl leading-relaxed">
      {t.disclaimer}
    </p>
    <p class="text-white/30 text-xs font-light">
      Rewild · Org.nr. 938 483 833 ·
      <a href={localePath(lang, '/vilkar')} class="hover:text-white transition-colors duration-200">{t.terms}</a>
    </p>
    <p class="text-white/30 text-xs font-light">© {year} Rewild</p>
  </div>
</footer>
