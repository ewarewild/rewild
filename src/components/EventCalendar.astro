---
import { Image } from 'astro:assets';
import { events, sessions, tripUrl, timeRange } from '../data/events';

interface Props {
  limit?: number;
}

const { limit = 0 } = Astro.props;

const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
---

<div class="event-calendar" data-limit={limit}>
  <div class="grid md:grid-cols-2 gap-4 md:gap-8 mb-20">
    {sessions.map(s => {
      const e = events[s.event];
      const day = new Date(`${s.date}T12:00:00`);
      return (
        <div class="cal-row bg-white group overflow-hidden flex flex-col" data-date={s.date} data-event={s.event}>
          {/* Phones: compact row with date badge, difficulty and time, photo on the right */}
          <a href={tripUrl(s)} class="md:hidden flex h-[176px]">
            <div class="flex-1 min-w-0 p-4 flex flex-col">
              <p class="text-[0.7rem] tracking-[0.2em] uppercase text-sage/80 font-light truncate">{s.place}</p>
              <h3 class="mt-1 font-display font-bold text-[1.1rem] text-forest leading-snug line-clamp-2">{e.name} - {s.spot ?? s.place}</h3>
              <div class="mt-auto flex items-center gap-3">
                <div class="w-14 h-14 shrink-0 flex flex-col items-center justify-center bg-cream text-forest">
                  <span class="font-display font-bold text-xl leading-none">{day.getDate()}</span>
                  <span class="mt-1 text-[0.7rem] tracking-[0.15em] uppercase font-light leading-none">{months[day.getMonth()].slice(0, 3)}</span>
                </div>
                <div class="min-w-0 space-y-1.5 text-[0.85rem] text-forest font-light">
                  {s.difficulty && (
                    <p class="flex items-center gap-2 truncate">
                      <svg class="w-4 h-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="10" width="3" height="5" rx="0.5"/><rect x="6.5" y="6" width="3" height="9" rx="0.5" opacity={s.difficulty === 'Easy' ? 0.3 : 1}/><rect x="12" y="2" width="3" height="13" rx="0.5" opacity={s.difficulty === 'Hard' ? 1 : 0.3}/></svg>
                      {s.difficulty}
                    </p>
                  )}
                  <p class="flex items-center gap-2 truncate">
                    <svg class="w-4 h-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9.2" cy="2.4" r="1.4" fill="currentColor" stroke="none"/><path d="M8.7 5.2L7.8 9.6M7.8 9.6L5.6 14.5M7.8 9.6L9.8 11.4L10.3 14.5M5.4 8L8.5 5.6L10.8 8.2"/></svg>
                    Joint-friendly
                  </p>
                  <p class="flex items-center gap-2 truncate">
                    <svg class="w-4 h-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5V8l2.5 1.5"/></svg>
                    {timeRange(s)}
                  </p>
                </div>
              </div>
            </div>
            <div class="w-[38%] shrink-0 overflow-hidden">
              <Image src={s.image ?? e.image} alt={e.alt} widths={[320, 480, 640, 960, 1200]} sizes="max(calc(38vw - 18px), 313px)" class="w-full h-full object-cover object-center" loading="lazy" />
            </div>
          </a>
          <a href={tripUrl(s)} class="hidden md:block">
            <div class="overflow-hidden h-72">
              <Image
                src={s.image ?? e.image}
                alt={e.alt}
                widths={[512, 768, 1024, 1536, 2048, 2400]}
                sizes="(min-width: 1152px) 512px, calc(50vw - 64px)"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </div>
          </a>
          <div class="hidden md:flex p-8 flex-col flex-1">
            <p class="text-xs tracking-[0.3em] uppercase text-sage/80 mb-3 font-light">{s.place}</p>
            <a href={tripUrl(s)} class="block">
              <h3 class="font-display font-bold text-3xl text-forest mb-5 leading-tight hover:opacity-60 transition-opacity duration-200">{e.name} - {s.spot ?? s.place}</h3>
            </a>
            <a href={tripUrl(s)} class="mb-6 flex items-center gap-5">
              <div class="w-20 h-20 shrink-0 flex flex-col items-center justify-center bg-cream text-forest">
                <span class="font-display font-bold text-3xl leading-none">{day.getDate()}</span>
                <span class="mt-1.5 text-xs tracking-[0.15em] uppercase font-light leading-none">{months[day.getMonth()].slice(0, 3)}</span>
              </div>
              <div class="min-w-0 space-y-2 text-[0.95rem] text-forest font-light">
                {s.difficulty && (
                  <p class="flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="10" width="3" height="5" rx="0.5"/><rect x="6.5" y="6" width="3" height="9" rx="0.5" opacity={s.difficulty === 'Easy' ? 0.3 : 1}/><rect x="12" y="2" width="3" height="13" rx="0.5" opacity={s.difficulty === 'Hard' ? 1 : 0.3}/></svg>
                    {s.difficulty}
                  </p>
                )}
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9.2" cy="2.4" r="1.4" fill="currentColor" stroke="none"/><path d="M8.7 5.2L7.8 9.6M7.8 9.6L5.6 14.5M7.8 9.6L9.8 11.4L10.3 14.5M5.4 8L8.5 5.6L10.8 8.2"/></svg>
                  Joint-friendly
                </p>
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0 text-sage" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5V8l2.5 1.5"/></svg>
                  {timeRange(s)}
                </p>
              </div>
            </a>
            <p class="text-forest font-light text-[1.08rem] leading-relaxed mb-8 flex-1">
              {s.description ?? e.description}
            </p>
            <div class="pt-5 border-t border-cream flex justify-between">
              <a href={tripUrl(s)} class="text-xs tracking-[0.25em] uppercase font-light text-sage/80 hover:text-sage transition-colors duration-300">More →</a>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <p class="cal-empty hidden text-forest font-light text-[1.08rem]">New dates coming soon.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.event-calendar').forEach(cal => {
    const limit = Number(cal.dataset.limit) || 0;
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const rows = [...cal.querySelectorAll<HTMLElement>('.cal-row')];

    const render = () => {
      let shown = 0;
      rows.forEach(row => {
        const upcoming = row.dataset.date! >= today;
        const visible = upcoming && (!limit || shown < limit);
        row.hidden = !visible;
        if (visible) shown++;
      });
      cal.querySelector('.cal-empty')?.classList.toggle('hidden', shown > 0);
    };

    render();
  });
</script>
