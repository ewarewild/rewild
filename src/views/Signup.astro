---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { events, sessions, signupLabel, signupText, price } from '../data/events';
import { langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const t = lang === 'no'
  ? {
      title: 'Påmelding - Rewild',
      description: 'Meld deg på en Rewild Trip, en Evening Reset eller et en-til-en-opplegg med Rewild.',
      heading: 'Påmelding', name: 'Navn', email: 'E-postadresse', phone: 'Telefonnummer', event: 'Tur eller kurs',
      oneToOne: 'En-til-en-opplegg',
      injuries: 'Har du noen skader eller vondt i ryggen?',
      why: 'Hva fikk deg til å melde deg på?',
      privacy: 'Personvernet ditt er viktig - opplysningene dine deles ikke med noen.',
      disclaimer: 'Veiledningen på Rewild-arrangementer erstatter ikke medisinske råd. Har du en skade, bør du snakke med lege eller fysioterapeut før du blir med.',
      send: 'Send', sending: 'Sender...', vipps: 'Videre til Vipps',
      price: 'Pris: {nok} kr, betales med Vipps i neste steg.',
      ok: 'Takk - vi har mottatt opplysningene dine og tar kontakt snart.',
      error: 'Noe gikk galt da opplysningene skulle sendes. Prøv igjen om litt.',
    }
  : {
      title: 'Sign up - Rewild',
      description: 'Sign up for a Rewild Trip, an Evening Reset, or a One-to-One program with Rewild.',
      heading: 'Sign up', name: 'Name', email: 'Email address', phone: 'Telephone number', event: 'Event',
      oneToOne: 'One-to-One program',
      injuries: 'Do you have any injuries or back pain?',
      why: 'What inspired you to join this event?',
      privacy: 'Your privacy is important - your details will not be shared with anyone.',
      disclaimer: 'The guidance given during Rewild events is not a substitute for medical advice. If you have an injury, please consult a doctor or physiotherapist before participating.',
      send: 'Send', sending: 'Sending...', vipps: 'Continue to Vipps',
      price: 'Price: {nok} NOK, paid with Vipps on the next step.',
      ok: "Thank you - we've received your details and will be in touch soon.",
      error: 'Something went wrong sending your details. Please try again in a moment.',
    };
---

<Layout title={t.title} description={t.description}>

  <!-- Navigation -->
  <Nav />

  <!-- Form section -->
  <section class="bg-cream min-h-screen pt-32 pb-40 md:pt-44 md:pb-56">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-xl">
        <h1 class="font-display font-bold text-4xl md:text-5xl text-forest mb-14 leading-tight">{t.heading}</h1>

        <form
          id="signup-form"
          data-lang={lang}
          data-send={t.send}
          data-sending={t.sending}
          data-vipps={t.vipps}
          data-price={t.price}
          data-ok={t.ok}
          data-error={t.error}
          class="space-y-6"
        >
          <input type="hidden" name="access_key" value="ee1b8b87-7dbe-406e-b5e5-3bb4cabe5ec4" />
          <input type="hidden" name="subject" value="New Rewild sign up" />
          <input type="hidden" name="Language" value={lang === 'no' ? 'Norsk' : 'English'} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="block text-xs tracking-[0.2em] uppercase text-sage/80 font-light mb-3">{t.name}</label>
            <input
              type="text"
              id="name"
              name="Name"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div>
            <label for="email" class="block text-xs tracking-[0.2em] uppercase text-sage/80 font-light mb-3">{t.email}</label>
            <input
              type="email"
              id="email"
              name="Email"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div>
            <label for="phone" class="block text-xs tracking-[0.2em] uppercase text-sage/80 font-light mb-3">{t.phone}</label>
            <input
              type="tel"
              id="phone"
              name="Telephone"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200"
            />
          </div>

          <div class="relative">
            <label for="event" class="block text-xs tracking-[0.2em] uppercase text-sage/80 font-light mb-3">{t.event}</label>
            <select
              id="event"
              name="Offering"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 appearance-none cursor-pointer"
            >
              <option value="" disabled selected></option>
              {[...sessions].sort((a, b) => events[a.event].name.localeCompare(events[b.event].name)).map(s => (
                <option value={signupLabel(s)} data-date={s.date} data-price={price(s)}>{signupText(s, lang)}</option>
              ))}
              <option value="One-to-One program">{t.oneToOne}</option>
            </select>
            <span class="pointer-events-none absolute right-4 top-[2.85rem] text-forest/40">↓</span>
          </div>

          <div id="injuries-field">
            <label for="injuries" class="block text-xs tracking-[0.2em] uppercase text-sage/80 font-light mb-3">{t.injuries}</label>
            <textarea
              id="injuries"
              name="Injuries"
              rows="4"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <div id="why-field">
            <label for="why" class="block text-xs tracking-[0.2em] uppercase text-sage/80 font-light mb-3">{t.why}</label>
            <textarea
              id="why"
              name="Why"
              rows="4"
              required
              class="w-full bg-white border border-forest/20 px-4 py-3 text-forest font-light text-sm focus:outline-none focus:border-forest transition-colors duration-200 resize-none"
            ></textarea>
          </div>

          <div class="pt-4">
            <button
              id="signup-submit"
              type="submit"
              class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
            >
              {t.send}
            </button>
            <p id="price-note" class="hidden text-base text-forest font-light mt-4"></p>
            <p class="text-base text-sage font-light mt-4">{t.privacy}</p>
            <p class="text-sm text-forest/60 font-light mt-4 leading-relaxed">{t.disclaimer}</p>
            <p id="signup-status" class="text-sm font-light mt-4" role="status"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>

<script>
  const eventSelect = document.getElementById('event') as HTMLSelectElement;
  const injuriesField = document.getElementById('injuries-field') as HTMLElement;
  const injuriesTextarea = document.getElementById('injuries') as HTMLTextAreaElement;

  const submitButton = document.getElementById('signup-submit') as HTMLButtonElement;
  const priceNote = document.getElementById('price-note') as HTMLElement;
  const msg = (document.getElementById('signup-form') as HTMLFormElement).dataset;

  // Trips are paid with Vipps straight after sending the form; 1:1 is a request only
  // Free trips (price 0) skip Vipps and send the form only
  const selectedPrice = () => {
    const nok = eventSelect.selectedOptions[0]?.dataset.price;
    return nok && nok !== '0' ? nok : undefined;
  };
  const idleLabel = () => (selectedPrice() ? msg.vipps! : msg.send!);

  eventSelect?.addEventListener('change', () => {
    const isDeepRest = eventSelect.value.startsWith('Deep Rest');
    injuriesField.style.display = isDeepRest ? 'none' : 'block';
    injuriesTextarea.required = !isDeepRest;

    const nok = selectedPrice();
    priceNote.textContent = nok ? msg.price!.replace('{nok}', nok) : '';
    priceNote.classList.toggle('hidden', !nok);
    submitButton.textContent = idleLabel();
  });

  // Drop trips whose date has passed
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  eventSelect.querySelectorAll<HTMLOptionElement>('option[data-date]').forEach(o => {
    if (o.dataset.date! < today) o.remove();
  });

  // Pre-select the event when coming from a calendar "Sign up" link
  const preselect = new URLSearchParams(location.search).get('event');
  if (preselect && [...eventSelect.options].some(o => o.value === preselect)) {
    eventSelect.value = preselect;
    eventSelect.dispatchEvent(new Event('change'));
  }

  const form = document.getElementById('signup-form') as HTMLFormElement;
  const statusEl = document.getElementById('signup-status') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitButton.disabled = true;
    submitButton.textContent = msg.sending!;
    statusEl.textContent = '';

    try {
      const formData = new FormData(form);

      // Start the Vipps payment first, so the sign-up email carries its reference
      let redirectUrl = '';
      if (selectedPrice()) {
        const pay = await fetch('/api/pay', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ offering: eventSelect.value, name: formData.get('Name'), email: formData.get('Email'), phone: formData.get('Telephone'), lang: msg.lang }),
        });
        const payment = await pay.json().catch(() => ({}));
        if (!pay.ok || !payment.redirectUrl) throw new Error('payment');
        redirectUrl = payment.redirectUrl;
        formData.append('Payment', `${selectedPrice()} NOK via Vipps, reference ${payment.reference} - check it's paid in the Vipps portal`);
      }

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (response.ok && result.success && redirectUrl) {
        location.href = redirectUrl;
        return;
      } else if (response.ok && result.success) {
        form.reset();
        statusEl.textContent = msg.ok!;
        statusEl.className = 'text-sm font-light mt-4 text-sage';
      } else {
        statusEl.textContent = msg.error!;
        statusEl.className = 'text-sm font-light mt-4 text-red-700';
      }
    } catch {
      statusEl.textContent = msg.error!;
      statusEl.className = 'text-sm font-light mt-4 text-red-700';
    }
    submitButton.disabled = false;
    submitButton.textContent = idleLabel();
  });

  // Coming back from Vipps with the browser's back button restores the page mid-submit
  window.addEventListener('pageshow', () => {
    submitButton.disabled = false;
    submitButton.textContent = idleLabel();
  });
</script>
