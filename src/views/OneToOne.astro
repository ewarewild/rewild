---
import { heroImage as heroPhoto } from '../lib/hero';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import moss from '../images/moss.webp';
import { langFromPath, localePath } from '../i18n';

const heroImage = await heroPhoto(moss, 65);
const lang = langFromPath(Astro.url.pathname);
const p = (path: string) => localePath(lang, path);
const t = lang === 'no'
  ? {
      title: 'En-til-en - Rewild',
      description: 'Skreddersydde aktiviteter etter dine behov. Et personlig opplegg med tett oppfølging, slik at du når målene dine.',
      back: 'Alle turer',
      tagline: 'Vi finner veien sammen, i ditt tempo.',
      heading: 'En-til-en',
      paragraphs: [
        'Enten du er på vei tilbake etter en skade eller utbrenthet, trener mot et bestemt mål, eller bare vil bevege deg og ha det bedre i hverdagen, tar øktene utgangspunkt i hvor du er.',
        'Vi starter med en konsultasjon - for å forstå hvor du er fysisk og mentalt, og hva du jobber mot.',
        'Ut fra det bygger vi et opplegg helt rundt deg: riktig aktivitet, bevegelsene som støtter deg best, det beste terrenget og riktig tempo.',
        'Øktene foregår ute, ansikt til ansikt, i Telemark og Vestfold - i naturen nærmest deg.',
        'Du får tett personlig veiledning hele veien, og opplegget justeres etter hvert som du utvikler deg.',
      ],
      prices: [
        ['Konsultasjon', '500 kr / økt på 1 time'],
        ['Opptil 4 økter', '1200 kr / økt på 2 timer'],
        ['5 eller flere', '1000 kr / økt på 2 timer'],
      ],
      signup: 'Meld deg på',
    }
  : {
      title: 'One-to-One - Rewild',
      description: 'Tailor-made activities for your individual needs. A personally guided program for maximum support in fulfilling your goals and intentions.',
      back: 'All events',
      tagline: 'Your path at your pace.',
      heading: 'One-to-One',
      paragraphs: [
        "Whether you're recovering from injury, burnout, training for a specific goal, or simply looking to move and feel better in everyday life, the sessions meet you where you are.",
        "A one-to-one begins with a consultation - to understand where you are physically and mentally, and what you're working towards.",
        'From there, we build a practice entirely around you: the appropriate activity, the most supportive movement, the optimal terrain, and the right pace.',
        'Sessions take place in person, outdoors in Telemark and Vestfold - in the nature closest to you.',
        'You receive full personal guidance throughout, with the program adapting as you progress.',
      ],
      prices: [
        ['Consultation', '500 NOK / 1h session'],
        ['Up to 4 sessions', '1200 NOK / 2h session'],
        ['5 or more', '1000 NOK / 2h session'],
      ],
      signup: 'Sign up',
    };
---

<Layout title={t.title} description={t.description} preloadImage={heroImage}>

  <!-- Navigation -->
  <Nav />

  <!-- Hero image -->
  <section class="relative mt-[60px] overflow-hidden" style="height: 65vh;">
    <img
      src={heroImage.src}
      srcset={heroImage.srcset}
      sizes={heroImage.sizes}
      alt=""
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover" style="object-position: center 60%;"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,25,14,0.5) 0%, transparent 60%);"></div>
    <a href={p('/#events')} class="absolute top-6 left-6 md:left-12 inline-flex items-center gap-2 text-xs tracking-[0.25em] uppercase font-light text-white hover:opacity-70 transition-opacity duration-200">
      <span>←</span><span>{t.back}</span>
    </a>
  </section>

  <!-- Title strip (bg-white) -->
  <div class="bg-white py-10 px-6 text-center">
    <p class="font-display font-normal italic text-forest text-[16pt] md:text-[20.5pt] lg:text-[25pt] leading-relaxed max-w-2xl mx-auto">{t.tagline}</p>
  </div>

  <!-- Intro section (bg-cream) -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-[420px]">
        <h2 class="font-display font-medium text-4xl md:text-5xl text-forest mb-10 leading-tight">{t.heading}</h2>
        <div class="space-y-5 text-forest font-light leading-relaxed text-[1.08rem]">
          {t.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Details (bg-white) -->
  <section class="bg-white py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-[5fr_7fr] gap-16 md:gap-24">
        <div>
          <div class="space-y-4">
            {t.prices.map(([label, value]) => (
              <div class="flex gap-6">
                <span class="text-xs tracking-[0.2em] uppercase text-sage/80 font-light w-28 flex-shrink-0">{label}</span>
                <span class="text-base text-forest font-light">{value}</span>
              </div>
            ))}
            <div class="pt-12">
              <a
                href={p('/signup')}
                class="inline-block px-10 py-4 bg-forest text-white text-xs tracking-[0.25em] uppercase font-light hover:bg-sage transition-colors duration-300"
              >
                {t.signup}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>
