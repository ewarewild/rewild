---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { langFromPath, localePath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const p = (path: string) => localePath(lang, path);
// Messages for the script below, which picks one once it knows the payment's status
const t = lang === 'no'
  ? {
      title: 'Betaling - Rewild', description: 'Påmeldingen din hos Rewild.',
      checking: 'Sjekker betalingen din...', moment: 'Dette tar bare et øyeblikk.', events: 'Alle turer',
      notThroughTitle: 'Betalingen din har ikke kommet gjennom',
      notThroughText: 'Hvis du har betalt i Vipps, kan det ta noen minutter før den dukker opp - jeg bekrefter plassen din på e-post. Hvis ikke, kan du gjerne melde deg på igjen eller ta kontakt hvis du har spørsmål.',
      contact: 'Ta kontakt',
      paidTitle: 'Takk - du er påmeldt!',
      paidText: 'Betalingen er bekreftet. Du får en e-post med alt du trenger å vite før turen.',
      cancelledTitle: 'Betalingen ble avbrutt',
      cancelledText: 'Plassen din er derfor ikke reservert. Du kan melde deg på igjen når du vil.',
      signup: 'Meld deg på',
    }
  : {
      title: 'Payment - Rewild', description: 'Your Rewild booking.',
      checking: 'Checking your payment...', moment: 'This only takes a moment.', events: 'All events',
      notThroughTitle: "Your payment hasn't come through",
      notThroughText: "If you paid in Vipps, it may take a few minutes to show up - we'll confirm your place by email. If not, you're welcome to sign up again, or get in touch if you have any questions.",
      contact: 'Get in touch',
      paidTitle: "Thank you - you're booked!",
      paidText: "Your payment is confirmed. You'll receive an email with everything you need to know before the hike.",
      cancelledTitle: 'Payment cancelled',
      cancelledText: 'Your payment was cancelled, so your place has not been booked. You can sign up again whenever you like.',
      signup: 'Sign up',
    };
const messages = JSON.stringify({ ...t, eventsHref: p('/#events'), contactHref: p('/contact'), signupHref: p('/signup') });
---

<Layout title={t.title} description={t.description}>

  <!-- Navigation -->
  <Nav />

  <!-- Vipps sends the customer back here with ?ref=...; the script below asks /api/payment-status -->
  <section class="bg-cream min-h-screen pt-32 pb-40 md:pt-44 md:pb-56">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <div class="max-w-xl">
        <h1 id="payment-title" class="font-display font-bold text-4xl md:text-5xl text-forest mb-10 leading-tight">{t.checking}</h1>
        <p id="payment-text" class="text-forest font-light text-[1.08rem] leading-relaxed">{t.moment}</p>
        <a id="payment-link" data-messages={messages} href={p('/#events')} class="hidden mt-12 px-10 py-4 border border-forest text-forest text-xs tracking-[0.25em] uppercase font-light hover:bg-forest hover:text-white transition-colors duration-300">{t.events}</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />

</Layout>

<script>
  const title = document.getElementById('payment-title') as HTMLElement;
  const text = document.getElementById('payment-text') as HTMLElement;
  const link = document.getElementById('payment-link') as HTMLAnchorElement;
  const ref = new URLSearchParams(location.search).get('ref');
  const m = JSON.parse(link.dataset.messages!);

  const show = (heading: string, body: string, button?: { href: string; label: string }) => {
    title.textContent = heading;
    text.textContent = body;
    if (button) {
      link.href = button.href;
      link.textContent = button.label;
      link.classList.replace('hidden', 'inline-block');
    }
  };

  const notThrough = () => show(m.notThroughTitle, m.notThroughText, { href: m.contactHref, label: m.contact });

  // Vipps can take a few seconds to register the payment after the customer returns
  const check = async (attempt = 0): Promise<void> => {
    try {
      const res = await fetch(`/api/payment-status?ref=${encodeURIComponent(ref!)}`);
      const { status } = await res.json();
      if (status === 'paid') {
        return show(m.paidTitle, m.paidText, { href: m.eventsHref, label: m.events });
      }
      if (status === 'cancelled') {
        return show(m.cancelledTitle, m.cancelledText, { href: m.signupHref, label: m.signup });
      }
      if (status === 'pending' && attempt < 5) {
        await new Promise(r => setTimeout(r, 2000));
        return check(attempt + 1);
      }
      notThrough();
    } catch {
      notThrough();
    }
  };

  if (ref) check();
  else notThrough();
</script>
