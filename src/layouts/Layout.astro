---
import '../styles/global.css';
import type { Hero } from '../lib/hero';
import { langFromPath, otherLangPath } from '../i18n';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  preloadImage?: Hero; // the page's hero photo, fetched first
}

const lang = langFromPath(Astro.url.pathname);
const { title, description = lang === 'no' ? 'Rewild - guidede turer og kurs i naturen i Telemark og Vestfold' : 'Rewild - come back to yourself through nature', ogTitle, ogDescription, ogImage, preloadImage } = Astro.props;
// The page's Norwegian and English addresses, for search engines
const pathname = Astro.url.pathname;
const alternates = [
  { hreflang: 'nb', href: new URL(lang === 'no' ? pathname : otherLangPath(pathname), Astro.site) },
  { hreflang: 'en', href: new URL(lang === 'en' ? pathname : otherLangPath(pathname), Astro.site) },
];
// Link previews (Facebook, Messenger etc.): a 1200x630 JPG unless a page passes its own
const SHARE_IMAGE = '/images/share-hero.jpg'; // made from the homepage hero (src/images/jot.webp)
const ogImageAlt = lang === 'no' ? 'Steinete fjellrygg over en dal med innsjøer og drivende skyer' : 'Rocky mountain ridge above a valley with lakes and drifting cloud';
const ogImageUrl = new URL(ogImage ?? SHARE_IMAGE, Astro.site);
---

<!doctype html>
<html lang={lang === 'no' ? 'nb' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'no' ? 'nb_NO' : 'en_GB'} />
    {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImageUrl} />
    {!ogImage && <meta property="og:image:type" content="image/jpeg" />}
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Sanchez&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
