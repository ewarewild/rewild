// Cloudflare Worker "rewild" (re-wild.no). Workers Builds runs `npm run build`, then
// `npx wrangler deploy` for main and `npx wrangler versions upload` for other branches.
{
  "name": "rewild",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Everything except the Vipps API is served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  // The Vipps keys are set in the dashboard; don't let a deploy remove them
  "keep_vars": true,
  "preview_urls": true
}
