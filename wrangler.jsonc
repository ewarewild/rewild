// Cloudflare Worker "rewild" (re-wild.no). Workers Builds runs `npm run build`, then
// `npx wrangler deploy` for main and `npx wrangler versions upload` for other branches.
{
  "name": "rewild",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Everything except the Vipps API is served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  // Customer details between starting a Vipps payment and it going through (worker/booking.ts)
  "kv_namespaces": [{ "binding": "BOOKINGS", "id": "105991845a8f4dfb871342be6fc84471" }],
  // The Vipps and Resend keys are set in the dashboard; don't let a deploy remove them
  "keep_vars": true,
  "preview_urls": true
}
